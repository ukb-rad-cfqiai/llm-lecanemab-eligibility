# Localhost-only batch inference on eight A100 80 GB GPUs.
# Change HF_HOME if the offline Hugging Face cache is elsewhere.
BATCH_CLIENT_MODE_ON="true"
BATCH_CLIENT_LISTEN_PORT="30000"
BATCH_CLIENT_DIRECT_PORT_START="30001"
BATCH_CLIENT_DIRECT_PORT_END="30032"
HF_HOME="~/.cache/huggingface"
MODEL_DEPLOYMENT_CONFIG="./utils/ukb_gpt_profiles/gpt-oss-120b.toml"
VLLM_LLM_MAX_MODEL_LEN="65536"
VLLM_LLM_GPU_MEMORY_UTILIZATION="0.90"
